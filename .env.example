# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# DATABASE_URL=sqlite:///database/rubicore.db   (default). Any SQLAlchemy URL works, e.g. a PostgreSQL server you run yourself.
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Kolkata

# LLM: gemini | ollama | none
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

STOCK_PROVIDER=yahoo
NEWS_PROVIDER=rss

# There are no accounts, passwords or sign-up. The app opens with this 4-digit PIN (or an enrolled face).
APP_PIN=1224
